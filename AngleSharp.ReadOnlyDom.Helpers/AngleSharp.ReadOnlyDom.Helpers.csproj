<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Product>AngleSharp.ReadOnlyDom.Helpers</Product>
    <PackageId>AngleSharp.ReadOnlyDom.Helpers</PackageId>
    <Version>1.0.1</Version>
    <Authors>dv00d00</Authors>
    <Company>AngleSharp</Company>
    <Description>HTML parsing/query/HTTP helpers for AngleSharp.ReadOnlyDom (uses .NET 8+ APIs such as SearchValues and generic math)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
    <PackageReference Include="AngleSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AngleSharp.ReadOnlyDom\AngleSharp.ReadOnlyDom.csproj" />
  </ItemGroup>
</Project>
