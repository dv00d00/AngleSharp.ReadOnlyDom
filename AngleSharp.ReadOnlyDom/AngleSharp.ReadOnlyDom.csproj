<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Product>AngleSharp.ReadOnlyDom</Product>
    <PackageId>AngleSharp.ReadOnlyDom</PackageId>
    <Version>1.0.1</Version>
    <Authors>dv00d00</Authors>
    <Company>AngleSharp</Company>
    <Description>Lightweight DOM implementation with low memory allocations</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AngleSharp.ReadOnlyDom.Helpers" />
  </ItemGroup>
</Project>
